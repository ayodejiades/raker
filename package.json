{
  "name": "settlement-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev & vite dev",
    "dev:frontend": "vite dev",
    "dev:backend": "convex dev",
    "build": "vite build",
    "deploy": "convex deploy --cmd 'npm run build' && convex run static-hosting:deploy --dist dist || npx @convex-dev/static-hosting deploy --dist dist",
    "lint": "eslint .",
    "typecheck": "tsc -p . --noEmit && tsc -p convex --noEmit"
  },
  "dependencies": {
    "@agentmail/convex": "^0.1.0",
    "@convex-dev/static-hosting": "^0.1.3",
    "@firecrawl/firecrawl-convex": "^0.1.0",
    "convex": "^1.33.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
